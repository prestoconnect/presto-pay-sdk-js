<%- include('partials/header', { title }) %>
<h1><%= title %></h1>
<p><%= description %></p>
<form method="post" action="<%= action %>">
  <label>Amount (MYR)<br><input name="amount" inputmode="decimal" placeholder="10.00" required></label>
  <label>Description<br><input name="description" maxlength="255" placeholder="Order description" required></label>
  <% if (methods.length) { %>
    <fieldset>
      <legend>Payment methods</legend>
      <% methods.forEach((method, index) => { %>
        <label class="check"><input type="checkbox" name="paymentMethod" value="<%= method.value %>" <%= index === 0 ? 'checked' : '' %>> <%= method.label %></label>
      <% }); %>
    </fieldset>
  <% } else { %>
    <p class="muted">The gateway will present its hosted payment options.</p>
  <% } %>
  <button type="submit">Continue to payment</button>
</form>
<p><a href="/">Back</a></p>
<%- include('partials/footer') %>
