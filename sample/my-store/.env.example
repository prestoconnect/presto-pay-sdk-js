# Copy to .env (or export these yourself) and adjust. Everything here has a sane default that works with the
# staging demo merchant already committed under ../../spec/keys/ — you only need this file to change the port
# or to expose the server publicly (e.g. via a tunnel) so Presto can actually deliver webhooks to it.

# The port the demo Express server listens on.
PORT=3000

# What Presto should redirect the customer to, and where it should POST webhooks. Defaults to
# http://localhost:$PORT, which works for the payment flow (init/query/reverse/refund) but NOT for webhook
# delivery — Presto cannot reach your localhost. To see /presto/notify actually fire, tunnel the port (e.g.
# `ngrok http 3000`) and set this to the tunnel's https URL, e.g.:
# PUBLIC_URL=https://abcd1234.ngrok-free.app
PUBLIC_URL=

# Staging credentials are intentionally not committed to this repository.
PRESTOPAY_MID=your-staging-merchant-id
PRESTO_MRN=your-staging-merchant-reference
PRESTOPAY_PRIVATE_KEY_FILE=/absolute/path/to/merchant-key-pkcs8.pem
PRESTOPAY_PUBLIC_KEY_FILE=/absolute/path/to/presto-public-key.der
